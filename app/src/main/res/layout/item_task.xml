<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingVertical="4dp">

    <TextView android:id="@+id/tvName" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1.2"
        android:textColor="#FFFFFF" android:textStyle="bold"/>
    <TextView android:id="@+id/tvCurrent" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="#FFD54F" android:textSize="12sp"/>
    <EditText android:id="@+id/tvTarget" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="0.8"
        android:inputType="number" android:textColor="#FFFFFF" android:textSize="12sp"/>
    <Button android:id="@+id/btnUp" android:layout_width="34dp"
        android:layout_height="34dp" android:text="↑" android:textSize="11sp"/>
    <Button android:id="@+id/btnDown" android:layout_width="34dp"
        android:layout_height="34dp" android:text="↓" android:textSize="11sp"/>
    <Button android:id="@+id/btnDel" android:layout_width="34dp"
        android:layout_height="34dp" android:text="✕" android:textSize="11sp"/>
</LinearLayout>